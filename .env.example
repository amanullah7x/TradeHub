# Server settings. Copy to .env on the host, or set these in your hosting dashboard.

NODE_ENV=production
PORT=4000

# Required in production. A long random string, e.g. from: openssl rand -hex 48
JWT_SECRET=

# Where the database and uploaded photos are stored. Must be on a persistent disk.
DB_FILE=/data/tradehub.db
UPLOADS_DIR=/data/uploads

# Number of reverse proxies in front of the server (1 for most hosts), so rate limits see real visitor IPs.
TRUST_PROXY=1

# Comma-separated emails of accounts that can use the admin API (reports, ads, stats).
ADMIN_EMAILS=

# Leave empty when the website is served by this server. Set only if another website must call the API.
CORS_ORIGIN=

# "test" applies purchases without charging. Switch to "live" once a payment provider is connected.
PAYMENTS_MODE=test

# Symbol shown in front of amounts in system messages.
CURRENCY=Rs

# --- App build settings (used when building the website and mobile apps) ---
# EXPO_PUBLIC_API_URL=https://your-domain.com        (mobile builds only)
# EXPO_PUBLIC_CONTACT_EMAIL=support@your-domain.com
# EXPO_PUBLIC_CURRENCY_SYMBOL=Rs
# EXPO_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# EXPO_PUBLIC_ADSENSE_SLOT=1234567890
